# ---------------------------------------------------------------
# CS2 Plugin Compiler – Einstellungen
# Nach Änderungen:  docker compose up -d
# ---------------------------------------------------------------

# Name der Seite (Kopfzeile)
SITE_NAME="CS2 Plugin Compiler"

# Betreiber in der Fußzeile, z. B. SITE_OWNER='Mein Clan' und SITE_OWNER_URL='https://example.com'
# (leer = „Betrieben von …“ wird ausgeblendet)
SITE_OWNER=""
SITE_OWNER_URL=""

# Kleine Zeile unter dem Namen und Text im Logo-Kästchen (max. 4 Zeichen)
SITE_SUBTITLE="CounterStrikeSharp · CS2"
SITE_LOGO="C#"

# Große Überschrift und Text darunter auf der Startseite (leer = Standardtext)
HERO_TITLE_DE=""
HERO_TEXT_DE=""
HERO_TITLE_EN=""
HERO_TEXT_EN=""

# Links für Impressum und Datenschutz (in Deutschland Pflicht!), z. B. https://example.com/impressum/
# (leer = Link wird ausgeblendet)
IMPRESSUM_URL=""
DATENSCHUTZ_URL=""

# Passwort für /admin (leer = Admin-Bereich aus)
ADMIN_PASSWORD=

# Adresse: unter einem Unterpfad deiner Domain (https://example.com/compiler/) -> BASE_PATH=/compiler
# eigene Subdomain (https://compiler.example.com/) -> BASE_PATH leer lassen
BASE_PATH=/compiler

# Port, auf dem der Compiler lokal lauscht (127.0.0.1)
PORT=8085

# Datenordner (absoluter Pfad). Leer lassen: install.sh setzt ihn automatisch
# auf den Ordner "data" im Installationsverzeichnis.
DATA_DIR=

# .NET-SDK für die Builds (baut net7.0, net8.0, net9.0 und net10.0)
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
SDK_MAX_MAJOR=10

# Leistung und Grenzen
MAX_PARALLEL=2
MAX_QUEUE=30
RATE_LIMIT_PER_HOUR=20
MAX_UPLOAD_MB=20
MAX_EXTRACTED_MB=150
BUILD_MEMORY=2g
BUILD_CPUS=2
RESTORE_TIMEOUT=240
BUILD_TIMEOUT=240

# Aufbewahrung
JOB_TTL_MIN=60
HISTORY_DAYS=30

# Echte Besucher-IP aus X-Real-IP / X-Forwarded-For lesen (hinter nginx/Apache: true)
TRUST_PROXY=true

# --- Metamod:Source-Compiler (C++, ab 1.2.0) ----------------------------------
# Beim ersten Start wird die Build-Umgebung automatisch gebaut (lädt mehrere GB,
# dauert einige Minuten). Aktualisieren: Admin-Bereich → "Metamod/CS2-SDK aktualisieren".
METAMOD_ENABLED=true
# steamrt3 = Standard (passt zu den meisten Servern), steamrt4 = neuere Linux-Systeme.
# Beides: METAMOD_RUNTIMES=steamrt3,steamrt4 (doppelter Speicherplatz)
METAMOD_RUNTIMES=steamrt3
# Zeitlimits in Sekunden (Repository laden / Bauen)
MM_FETCH_TIMEOUT=180
MM_BUILD_TIMEOUT=420
# Maximale Repository-Größe in MB
MM_MAX_REPO_MB=300
# Git-Quellen nur von diesen Anbietern (Schutz vor Zugriffen ins eigene Netzwerk)
GIT_HOSTS=github.com,gitlab.com,codeberg.org,bitbucket.org
