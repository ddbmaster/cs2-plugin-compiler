# ---------------------------------------------------------------
# CS2 Plugin Compiler – Einstellungen
# Nach Änderungen:  docker compose up -d
# ---------------------------------------------------------------

# Name der Seite und Betreiber (Kopf- und Fußzeile)
SITE_NAME="CS2 Plugin Compiler"
SITE_OWNER=ddbmaster.de
SITE_OWNER_URL=https://ddbmaster.de

# Kleine Zeile unter dem Namen und Text im Logo-Kästchen (max. 4 Zeichen)
SITE_SUBTITLE="CounterStrikeSharp · CS2"
SITE_LOGO="C#"

# Große Überschrift und Text darunter auf der Startseite (leer = Standardtext)
HERO_TITLE_DE=""
HERO_TEXT_DE=""
HERO_TITLE_EN=""
HERO_TEXT_EN=""

# Links für Impressum und Datenschutz (in Deutschland Pflicht!)
IMPRESSUM_URL=https://ddbmaster.de/legal-notice/
DATENSCHUTZ_URL=https://ddbmaster.de/privacy-policy/

# Passwort für /admin (leer = Admin-Bereich aus)
ADMIN_PASSWORD=

# Adresse: unter einem Unterpfad von ddbmaster.de -> BASE_PATH=/compiler
# (eigene Subdomain wie compiler.ddbmaster.de -> BASE_PATH leer lassen)
BASE_PATH=/compiler

# Port, auf dem der Compiler lokal lauscht (127.0.0.1)
PORT=8085

# Datenordner auf dem Server
DATA_DIR=/opt/cssharp-compiler/data

# .NET-SDK für die Builds (baut net7.0, net8.0, net9.0 und net10.0)
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
SDK_MAX_MAJOR=10

# Leistung und Grenzen
MAX_PARALLEL=2
MAX_QUEUE=30
RATE_LIMIT_PER_HOUR=20
MAX_UPLOAD_MB=20
MAX_EXTRACTED_MB=150
BUILD_MEMORY=2g
BUILD_CPUS=2
RESTORE_TIMEOUT=240
BUILD_TIMEOUT=240

# Aufbewahrung
JOB_TTL_MIN=60
HISTORY_DAYS=30

# Echte Besucher-IP aus X-Real-IP / X-Forwarded-For lesen (hinter nginx/Apache: true)
TRUST_PROXY=true
